# Voxera frontend — local development
# Copy to `.env` in this directory (Vite loads it automatically).

# Backend base URL (HTTP). WebSocket URL is derived as ws(s)://…/ws/voice unless overridden below.
VITE_VOXERA_BACKEND_URL=http://127.0.0.1:8000

# Optional: explicit WebSocket URL (e.g. if you split HTTP and WS — not needed for local monolith)
# VITE_VOXERA_WS_URL=ws://127.0.0.1:8000/ws/voice

# Phone on same Wi‑Fi: use your computer's LAN IP for BOTH the page and this URL, e.g.
# VITE_VOXERA_BACKEND_URL=http://192.168.1.10:8000
# Then open the dev server at http://192.168.1.10:3000

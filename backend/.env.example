# --- HTTP / CORS ---
VOXERA_HOST=0.0.0.0
VOXERA_PORT=8000
# Comma-separated browser origins (Vercel production + previews you care about)
VOXERA_CORS_ORIGINS=https://your-app.vercel.app
# Optional: regex for extra origins (e.g. all Vercel previews)
# VOXERA_CORS_ORIGIN_REGEX=https://.*\\.vercel\\.app$

# When true, only server keys are used; client keys in WebSocket init are ignored.
VOXERA_DISALLOW_CLIENT_KEYS=false

# Optional: restrict Host header (set to your public API hostname behind nginx)
# VOXERA_ALLOWED_HOSTS=api.yourdomain.com

VOXERA_LOG_LEVEL=INFO

# Close voice WebSocket if no client traffic for N seconds (0 = disabled). Must exceed client ping interval (~25s).
VOXERA_WS_IDLE_TIMEOUT_SECONDS=0

# --- Provider keys (recommended on EC2; never commit real values) ---
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# --- Model defaults ---
OPENAI_MODEL=gpt-4o-mini
DEEPGRAM_MODEL=nova-2
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

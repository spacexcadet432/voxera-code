# =============================================================================
# Voxera backend — local development
# Copy to `.env` in this directory and fill in your keys.
# =============================================================================

# --- Server ---
# Bind address (0.0.0.0 allows phones on the same Wi‑Fi to call your laptop)
VOXERA_HOST=0.0.0.0
VOXERA_PORT=8000

# CORS: leave empty to allow any origin (simplest for localhost + LAN testing).
# Or set a comma-separated list, e.g. http://localhost:3000,http://127.0.0.1:3000
VOXERA_CORS_ORIGINS=

# Optional: regex for extra origins (uncommon for local-only)
# VOXERA_CORS_ORIGIN_REGEX=

# If true, the UI cannot override keys — only the three env vars below are used.
VOXERA_DISALLOW_CLIENT_KEYS=false

# Optional: restrict Host header (leave empty for local dev)
# VOXERA_ALLOWED_HOSTS=

VOXERA_LOG_LEVEL=INFO

# Optional WebSocket idle close (seconds, 0 = off). Must exceed client ping (~25s).
VOXERA_WS_IDLE_TIMEOUT_SECONDS=0

# --- Provider keys (recommended for a smooth local setup) ---
# When set, you can leave the in-app key fields empty if you prefer.
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# --- Model defaults ---
OPENAI_MODEL=gpt-4o-mini
DEEPGRAM_MODEL=nova-2
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
